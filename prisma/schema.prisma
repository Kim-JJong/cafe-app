// 설계: docs/DESIGN.md §4

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id           Int           @id @default(autoincrement())
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  basePrice    Int
  imageUrl     String?
  isAvailable  Boolean       @default(true) // 품절 토글
  isHidden     Boolean       @default(false) // 숨김: 손님 화면에서 빠짐 (삭제 대신)
  sortOrder    Int           @default(0)
  optionGroups OptionGroup[]
}

model OptionGroup {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String // "사이즈", "온도", "샷 추가"
  required   Boolean  @default(false)
  maxSelect  Int      @default(1)
  sortOrder  Int      @default(0)
  options    Option[]
}

model Option {
  id            Int         @id @default(autoincrement())
  optionGroupId Int
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id])
  name          String // "Large", "ICE"
  extraPrice    Int         @default(0)
  sortOrder     Int         @default(0)
}

model Customer {
  id         Int      @id @default(autoincrement())
  employeeNo String   @unique // 사번 — 정산 기준 키
  name       String
  // 추후 로그인 도입 시 추가: email, authProviderId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Order {
  id                   Int         @id @default(autoincrement())
  businessDate         String // KST 영업일 "2026-10-16"
  orderNumber          Int // 영업일마다 1부터
  status               String // OrderStatus (DESIGN.md §5), 앱 코드에서 검증
  totalPrice           Int
  customerId           Int
  customer             Customer    @relation(fields: [customerId], references: [id])
  customerNameSnapshot String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  pickedUpAt           DateTime?
  items                OrderItem[]

  @@unique([businessDate, orderNumber])
  @@index([status])
  @@index([customerId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id           Int               @id @default(autoincrement())
  orderId      Int
  order        Order             @relation(fields: [orderId], references: [id])
  menuItemId   Int
  nameSnapshot String
  unitPrice    Int // basePrice + 옵션 합계 (주문 시점)
  quantity     Int
  options      OrderItemOption[]
}

model OrderItemOption {
  id           Int       @id @default(autoincrement())
  orderItemId  Int
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  nameSnapshot String // "사이즈: Large"
  extraPrice   Int
}

// 단체 주문 방 (DESIGN.md §12). 방장 한 명이 사고, 팀원은 이름만 넣고 음료를 담는다.
model GroupRoom {
  id         String        @id // 공유 링크에 들어가는 추측하기 어려운 무작위 값
  hostKey    String // 방장 권한 확인용 비밀값. 방장의 GroupMember.memberKey와 같다
  employeeNo String // 결제(급여 공제) 대상 = 방장 사번
  hostName   String
  deadlineAt DateTime // 이후에는 음료를 담을 수 없음
  status     String // OPEN | ORDERING(주문 처리 중) | ORDERED
  orderId    Int?
  createdAt  DateTime      @default(now())
  members    GroupMember[]
  items      GroupItem[]
}

model GroupMember {
  id        Int         @id @default(autoincrement())
  roomId    String
  room      GroupRoom   @relation(fields: [roomId], references: [id])
  memberKey String // 본인 항목 삭제 확인용 비밀값 (참여자 브라우저에만 저장)
  name      String
  createdAt DateTime    @default(now())
  items     GroupItem[]

  @@unique([roomId, memberKey])
}

model GroupItem {
  id           Int         @id @default(autoincrement())
  roomId       String
  room         GroupRoom   @relation(fields: [roomId], references: [id])
  memberId     Int
  member       GroupMember @relation(fields: [memberId], references: [id])
  menuItemId   Int
  optionIds    String // "3,7" (주문할 때 다시 검증)
  nameSnapshot String // 화면 표시용
  optionLabels String // "ICE · 연하게"
  unitPrice    Int
  quantity     Int
  createdAt    DateTime    @default(now())

  @@index([roomId])
}
